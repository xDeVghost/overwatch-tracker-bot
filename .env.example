# Telegram Bot Token (obtain from @BotFather)
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# Database file path (inside container: /app/data/ow_sessions.db)
DB_PATH=ow_sessions.db

# Default player platform: pc, console
DEFAULT_PLATFORM=pc

# Default bot language: ru, en
DEFAULT_LANGUAGE=ru

# OverFast API base URL (public or self-hosted)
OVERFAST_BASE_URL=https://overfast-api.tekrop.fr

# Polling interval in seconds (default: 300 = 5 minutes)
POLL_INTERVAL_SEC=300

# Session idle timeout in seconds (default: 900 = 15 minutes of inactivity closes session)
SESSION_TIMEOUT_SEC=900

# Minimum session play time in seconds (default: 300 = 5 minutes)
MIN_SESSION_SEC=300

# Observation norm calculation parameters
OBS_SEC=600
OBS_WINDOW=20
MIN_OBS=8

# Enable summary gate check (optional, default: false)
USE_SUMMARY_GATE=false
